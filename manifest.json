{
  "manifest_version": 3,
  "name": "SubLens",
  "version": "0.2.0",
  "description": "Launch AI tools fast and track connected subscriptions locally.",
  "permissions": ["storage", "alarms"],
  "optional_host_permissions": [
    "https://cursor.com/*",
    "https://github.com/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
